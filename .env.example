# Copy this file to .env and adjust the values for your server.
# Every setting is optional; the defaults shown here are used when omitted.

# Port the web server listens on.
PORT=3000

# Folder holding the SQLite database, uploaded photos and daily backups.
# Back up this folder regularly.
DATA_DIR=./data

# Set to true when the site is served over HTTPS.
# Required when NODE_ENV=production.
COOKIE_SECURE=false

# Time zone used for "today", due dates and staff edit limits.
TZ=Asia/Manila

# How many daily database backups to keep.
BACKUP_KEEP=30
