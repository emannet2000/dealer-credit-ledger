# Copy this file to .env and adjust as needed: cp .env.example .env
# Every setting is optional; the defaults below are what the app uses.

# Web server port
PORT=3000

# Where the database, photos and daily backups are stored. Back up this folder.
DATA_DIR=./data

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Time zone for "today", due dates and staff edit limits
TZ=Asia/Manila

# Days staff and viewer accounts stay signed in without use (owners/editors: 30)
STAFF_SESSION_DAYS=7

# Number of daily backups to keep
BACKUP_KEEP=30

# Optional command to copy each finished daily backup offsite.
# The backup path is passed in the BACKUP_FILE environment variable.
# Example: BACKUP_SYNC_CMD=rclone copy "$BACKUP_FILE" remote:ledger-backups
# BACKUP_SYNC_CMD=

# Optional: where to send an alert when a backup or offsite copy fails.
# ALERT_WEBHOOK_URL=https://hooks.example.com/...
# ALERT_CMD=./notify.sh   (the message is in ALERT_MESSAGE)
