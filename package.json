{
  "name": "dealer-credit-ledger",
  "version": "1.0.0",
  "description": "Dealer credit, collections and inventory system for direct-selling distributors.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/unit.test.js test/browser-logic.test.js",
    "test:property": "node --test test/property.test.js",
    "test:edge": "node --test test/edge.test.js",
    "test:functional": "node --test test/api.test.js test/ops.test.js test/extras.test.js test/finance.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/*.js test/*.test.js",
    "import": "node scripts/import-backup.js",
    "reset-password": "node scripts/reset-password.js",
    "restore": "node scripts/restore-db.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
